# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. NEVER commit real keys.
#
# In Google Colab, do NOT use a .env file — use the Secrets panel
# (the key icon in the left sidebar) instead.

# Required. Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Needed for rubric section 8 (LangSmith observability).
# Free key from https://smith.langchain.com -> Settings -> API Keys
LANGCHAIN_API_KEY=

# Tracing flag. Note the exact spelling: LANGCHAIN_TRACING_V2.
# It must be the STRING "true", not a boolean.
LANGCHAIN_TRACING_V2=true

# Any project name you like; this is what you look for in LangSmith.
LANGCHAIN_PROJECT=murshid-capstone
